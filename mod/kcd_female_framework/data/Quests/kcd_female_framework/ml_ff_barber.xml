<?xml version="1.0" encoding="utf-8"?>
<Database xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Name="brambora">
	<!-- A woman's haircut at the barbers of the game: any NPC with the role BARBER, like Fiala, Adam and Betty. Hair only:
	     a beard on a woman's head breaks the game. The dialog shows when Lua says the character in use is a woman
	     (ml_ff_woman), Henry or the new character of KCD2 Life. 50 groschen is the price of the game, or 5 with Realish
	     Economy, and coins go in tenths. The free haircut token, in Henry's inventory, makes the next one free: KCD2 Life
	     gives it before its new character starts. It hangs from the project to reach every map. -->
	<Skald>
		<Gameplay Name="ml_ff_barber">
			<Definitions>
				<Definition File="ml_ff_barber/ml_ff_barber_dialog.xml" />
			</Definitions>
			<Nodes>
				<ObjectProperties Name="henry" PositionY="-600" PositionX="-1200" DeclaringType="wh::rpgmodule::I_Soul">
					<Asset Name="I_Soul" Alias="henry" />
				</ObjectProperties>
				<State Name="always_on" PositionY="-750" PositionX="-1200" TypeT="bool">
					<Constant Name="DefaultValue" Value="true" />
				</State>
				<Function Name="free_descriptor" PositionY="-600" PositionX="-900" MethodName="wh::entitymodule::CreateItemClassDescriptor" DeclaringType="wh::entitymodule">
					<Constant Name="ItemClass" Value="9e740a59-a08d-509f-9315-1e93117357b2" />
					<Constant Name="Amount" Value="1" />
				</Function>
				<ItemDescriptorTrigger Name="free_token" PositionY="-600" PositionX="-600">
					<Edge From="henry.Inventory" To="Inventory" />
					<Edge From="free_descriptor.ItemDescriptor" To="ItemDescriptor" />
					<Edge From="always_on.State" To="IsActive" />
				</ItemDescriptorTrigger>
				<State Name="free_cut" PositionY="-450" PositionX="-600" TypeT="bool">
					<Constant Name="DefaultValue" Value="false" />
					<Edge From="free_token.OnAcquire" To="SetTrue" />
					<Edge From="free_or_paid.True" To="SetFalse" />
				</State>
				<!-- The price: the game's 50 groschen, or 5 with Realish Economy, as the game's barber asks with it. female_core.lua
				     gives one of these two tokens on each load, to Henry or to the new character of KCD2 Life, and the state keeps
				     it. Coins go in tenths. -->
				<ObjectProperties Name="new_life" PositionY="-150" PositionX="-1200" DeclaringType="wh::rpgmodule::I_Soul">
					<Asset Name="I_Soul" Alias="new_life" />
				</ObjectProperties>
				<Function Name="low_descriptor" PositionY="-300" PositionX="-900" MethodName="wh::entitymodule::CreateItemClassDescriptor" DeclaringType="wh::entitymodule">
					<Constant Name="ItemClass" Value="9fac282b-4ca3-5603-b1fa-a7e0078df693" />
					<Constant Name="Amount" Value="1" />
				</Function>
				<Function Name="game_descriptor" PositionY="-200" PositionX="-900" MethodName="wh::entitymodule::CreateItemClassDescriptor" DeclaringType="wh::entitymodule">
					<Constant Name="ItemClass" Value="96307008-123d-5fe0-b9a5-0e3f30a3fd5e" />
					<Constant Name="Amount" Value="1" />
				</Function>
				<ItemDescriptorTrigger Name="low_henry" PositionY="-350" PositionX="-600">
					<Edge From="henry.Inventory" To="Inventory" />
					<Edge From="low_descriptor.ItemDescriptor" To="ItemDescriptor" />
					<Edge From="always_on.State" To="IsActive" />
				</ItemDescriptorTrigger>
				<ItemDescriptorTrigger Name="low_life" PositionY="-300" PositionX="-600">
					<Edge From="new_life.Inventory" To="Inventory" />
					<Edge From="low_descriptor.ItemDescriptor" To="ItemDescriptor" />
					<Edge From="always_on.State" To="IsActive" />
				</ItemDescriptorTrigger>
				<ItemDescriptorTrigger Name="game_henry" PositionY="-250" PositionX="-600">
					<Edge From="henry.Inventory" To="Inventory" />
					<Edge From="game_descriptor.ItemDescriptor" To="ItemDescriptor" />
					<Edge From="always_on.State" To="IsActive" />
				</ItemDescriptorTrigger>
				<ItemDescriptorTrigger Name="game_life" PositionY="-200" PositionX="-600">
					<Edge From="new_life.Inventory" To="Inventory" />
					<Edge From="game_descriptor.ItemDescriptor" To="ItemDescriptor" />
					<Edge From="always_on.State" To="IsActive" />
				</ItemDescriptorTrigger>
				<State Name="low_price" PositionY="-300" PositionX="-450" TypeT="bool">
					<Constant Name="DefaultValue" Value="false" />
					<Edge From="low_henry.OnAcquire" To="SetTrue" />
					<Edge From="low_life.OnAcquire" To="SetTrue" />
					<Edge From="game_henry.OnAcquire" To="SetFalse" />
					<Edge From="game_life.OnAcquire" To="SetFalse" />
				</State>
				<Switch Name="full_price" PositionY="-300" PositionX="-300" TypeT="bool" ValueTypes="float" SwitchValues="true">
					<Constant Name="DefaultValue1" Value="50" />
					<Constant Name="trueValue1" Value="5" />
					<Edge From="low_price.State" To="Switch" />
				</Switch>
				<Switch Name="coins_amount" PositionY="650" PositionX="0" TypeT="bool" ValueTypes="int" SwitchValues="true">
					<Constant Name="DefaultValue1" Value="500" />
					<Constant Name="trueValue1" Value="50" />
					<Edge From="low_price.State" To="Switch" />
				</Switch>
				<Switch Name="price" PositionY="-150" PositionX="-300" TypeT="bool" ValueTypes="float" SwitchValues="true">
					<Edge From="full_price.Value1" To="DefaultValue1" />
					<Constant Name="trueValue1" Value="0" />
					<Edge From="free_cut.State" To="Switch" />
				</Switch>
				<ml_ff_barber_dialog Name="dialog" PositionY="0" PositionX="0">
					<Edge From="price.Value1" To="Payment_seq_ff_cut" />
				</ml_ff_barber_dialog>
				<IfFunction Name="free_or_paid" PositionY="50" PositionX="600" TypeT="bool" MethodName="Control::Compare" DeclaringType="Control">
					<Constant Name="Op" Value="Equals" />
					<Constant Name="ValueB" Value="true" />
					<Edge From="free_cut.State" To="ValueA" />
					<Edge From="dialog.accepted" To="Exec" />
				</IfFunction>
				<ObjectProperties Name="customer" PositionY="200" PositionX="300" DeclaringType="wh::rpgmodule::I_Soul">
					<Asset Name="I_Soul" Alias="player_any" />
				</ObjectProperties>
				<ObjectProperties Name="barber" PositionY="350" PositionX="300" DeclaringType="wh::rpgmodule::I_Soul">
					<Edge From="dialog.BARBER" To="I_Soul" />
				</ObjectProperties>
				<Function Name="coins" PositionY="500" PositionX="300" MethodName="wh::entitymodule::CreateItemClassDescriptor" DeclaringType="wh::entitymodule">
					<Constant Name="ItemClass" Value="5ef63059-322e-4e1b-abe8-926e100c770e" />
					<Edge From="coins_amount.Value1" To="Amount" />
				</Function>
				<EventMemberFunction Name="pay" PositionY="200" PositionX="600" MethodName="MoveItems" DeclaringType="wh::entitymodule::Inventory">
					<Constant Name="AllowPartialMatch" Value="false" />
					<Constant Name="ShowUINotification" Value="true" />
					<Edge From="free_or_paid.False" To="Exec" />
					<Edge From="coins.ItemDescriptor" To="ItemDescriptor" />
					<Edge From="customer.Inventory" To="SourceInventory" />
					<Edge From="barber.Inventory" To="TargetInventory" />
				</EventMemberFunction>
			</Nodes>
			<Assets>
				<SoulAsset Name="henry" SharedSoulGuids="4c2dcffb-dea1-6263-72d7-b39f4db2d8b5" />
				<SoulAsset Name="player_any" SharedSoulGuids="9a502475-ea84-448b-8922-7af61739b941" />
				<SoulAsset Name="new_life" SharedSoulGuids="e9f088ff-48e3-5fa1-b733-80504a56d1dc" />
			</Assets>
			<Text Text="ml_ff_barber" />
		</Gameplay>
	</Skald>
</Database>
