<?xml version="1.0" encoding="utf-8"?>
<Database xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" Name="brambora">
	<!-- Written by make_face_pack.py of KCD2 Female Framework from faces.toml. Each face: its token turns it on, and
	     the framework's reset turns it off; it answers the framework's question with its id, and puts its head and
	     body on Henry while it is on. -->
	<Skald>
		<Module Name="sample_own_head_faces">
			<Nodes>
				<ObjectProperties Name="henry" PositionY="0" PositionX="-1200" DeclaringType="wh::rpgmodule::I_Soul">
					<Asset Name="I_Soul" Alias="henry" />
				</ObjectProperties>
				<State Name="always_on" PositionY="-150" PositionX="-1200" TypeT="bool">
					<Constant Name="DefaultValue" Value="true" />
				</State>
				<Function Name="reset_descriptor" PositionY="-300" PositionX="-900" MethodName="wh::entitymodule::CreateItemClassDescriptor" DeclaringType="wh::entitymodule">
					<Constant Name="ItemClass" Value="8cfa0695-dd99-502c-a3de-e8ae4e4b057d" />
					<Constant Name="Amount" Value="1" />
				</Function>
				<ItemDescriptorTrigger Name="reset_token" PositionY="-300" PositionX="-600">
					<Edge From="henry.Inventory" To="Inventory" />
					<Edge From="reset_descriptor.ItemDescriptor" To="ItemDescriptor" />
					<Edge From="always_on.State" To="IsActive" />
				</ItemDescriptorTrigger>
				<Function Name="ask_descriptor" PositionY="-450" PositionX="-900" MethodName="wh::entitymodule::CreateItemClassDescriptor" DeclaringType="wh::entitymodule">
					<Constant Name="ItemClass" Value="80273b76-b1dc-5037-a03f-3b43e5799575" />
					<Constant Name="Amount" Value="1" />
				</Function>
				<ItemDescriptorTrigger Name="ask_token" PositionY="-450" PositionX="-600">
					<Edge From="henry.Inventory" To="Inventory" />
					<Edge From="ask_descriptor.ItemDescriptor" To="ItemDescriptor" />
					<Edge From="always_on.State" To="IsActive" />
				</ItemDescriptorTrigger>
				<Function Name="set_210_descriptor" PositionY="0" PositionX="-900" MethodName="wh::entitymodule::CreateItemClassDescriptor" DeclaringType="wh::entitymodule">
					<Constant Name="ItemClass" Value="2b04688c-e617-56bb-a782-2ab065025b87" />
					<Constant Name="Amount" Value="1" />
				</Function>
				<ItemDescriptorTrigger Name="set_token_210" PositionY="0" PositionX="-600">
					<Edge From="henry.Inventory" To="Inventory" />
					<Edge From="set_210_descriptor.ItemDescriptor" To="ItemDescriptor" />
					<Edge From="always_on.State" To="IsActive" />
				</ItemDescriptorTrigger>
				<State Name="chosen_210" PositionY="0" PositionX="-300" TypeT="bool">
					<Constant Name="DefaultValue" Value="false" />
					<Edge From="set_token_210.OnAcquire" To="SetTrue" />
					<Edge From="reset_token.OnAcquire" To="SetFalse" />
				</State>
				<If Name="answer_if_210" PositionY="0" PositionX="300">
					<Edge From="chosen_210.State" To="Condition" />
					<Edge From="ask_token.OnAcquire" To="Exec" />
				</If>
				<EventFunction Name="answer_210" PositionY="0" PositionX="600" MethodName="wh::entitymodule::CreatePlayerReward" DeclaringType="wh::entitymodule">
					<Constant Name="ItemClass" Value="66726bee-c42a-53d9-851f-9bb07d8bc27f" />
					<Constant Name="Amount" Value="210" />
					<Constant Name="ShowUINotification" Value="false" />
					<Edge From="answer_if_210.True" To="Exec" />
				</EventFunction>
				<BodyPartOverride Name="head_210" PositionY="0" PositionX="0">
					<Asset Name="Soul" Alias="henry" />
					<Constant Name="BodyPart" Value="Head" />
					<Constant Name="Component" Value="sample_own_head_head_sample_own_woman" />
					<Edge From="chosen_210.State" To="IsActive" />
				</BodyPartOverride>
				<BodyPartOverride Name="body_210" PositionY="70" PositionX="0">
					<Asset Name="Soul" Alias="henry" />
					<Constant Name="BodyPart" Value="Body" />
					<Constant Name="Component" Value="ml_ff_body_tan_03" />
					<Edge From="chosen_210.State" To="IsActive" />
				</BodyPartOverride>
			</Nodes>
			<Assets>
				<SoulAsset Name="henry" SharedSoulGuids="4c2dcffb-dea1-6263-72d7-b39f4db2d8b5" />
			</Assets>
			<Text Text="sample_own_head_faces" />
		</Module>
	</Skald>
</Database>
