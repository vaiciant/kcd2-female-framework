<?xml version="1.0" encoding="utf-8"?>
<kcd_mod>
	<info>
		<name>Fitted Gear for Female Framework</name>
		<modid>cyt_fitted_gear</modid>
		<description>All the mens armor and clothes refit for the Female Framework woman so it actually sits on her instead of hanging off henry's frame. Gambeson, padded hose, arm armor, cuirasses, brigandines, mail, long gambesons, caftans, coats, waffenrocks, habits, hoods, coifs and collars, story and DLC armor included. You need KCD2 Female Framework 0.4.0 or newer by vaiciant. Everything swaps to the fitted version on its own once a save loads, if it doesnt type cyt_gear_log in the console.</description>
		<author>Cytyryz</author>
		<version>1.0</version>
		<created_on>2026-11-13</created_on>
		<modifies_level>false</modifies_level>
	</info>
	<supports>
		<version>1.5*</version>
	</supports>
</kcd_mod>
